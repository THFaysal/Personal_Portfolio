# Example only. Copy to .env locally and never commit real credentials.
# Spring Boot does not automatically load .env; export these variables or use your IDE's run configuration.
PORT=8080
MONGODB_URI=mongodb://localhost:27017/portfolio?serverSelectionTimeoutMS=3000
RESEND_API_KEY=
EMAIL_TO=thfaysal711@gmail.com
