# Admin inbox. Replace these placeholders with PRIVATE environment variable values.
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=replace_with_a_unique_random_password_20_characters_or_longer
# Optional alternative: an externally generated BCrypt hash (takes priority over ADMIN_PASSWORD).
ADMIN_PASSWORD_HASH=
# In production HTTPS (Render): true. For localhost HTTP: false.
SESSION_COOKIE_SECURE=false
